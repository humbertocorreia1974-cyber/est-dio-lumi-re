generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  termsAcceptedAt  DateTime?
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  passwordHash     String
  // 2026-11-10 (auditoria builder/design): apps com needsWhatsApp/needsTelegram
  // geram codigo que faz user.phone / select phone:true sem o campo existir no
  // schema (ex: lembrete de agendamento via WhatsApp) - 500 em runtime
  // ("Unknown field 'phone'"). Campo opcional na fundacao resolve pra TODO app
  // futuro, nao so o que tinha o bug.
  phone            String?
  plan             String         @default("free")
  // 🩹 2026-09-01: apps com múltiplos papéis (jogador/dono, recepção/vet/admin…)
  // faziam `prisma.user.findMany({ where: { role } })` e o build quebrava
  // (TS2353: 'role' não existe em UserWhereInput). Agora a fundação tem o campo.
  role             String         @default("user")
  stripeCustomerId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  projects         Project[]
  bookings         Booking[]
  notifications    Notification[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Plan {
  id                   String    @id @default(cuid())
  name                 String
  price                Decimal
  durationMonths       Int
  limitClassesPerMonth Int
  description          String
  type                 String
  active               Boolean   @default(true)
  payments             Payment[]
}

model Class {
  id          String    @id @default(cuid())
  name        String
  type        String
  duration    Int
  level       String
  description String
  capacity    Int
  bookings    Booking[]
  workouts    Workout[]
}

model Booking {
  id               String    @id @default(cuid())
  schedulingDate   DateTime
  status           String
  price            Decimal
  observations     String?
  confirmationCode String
  class            Class     @relation(fields: [classId], references: [id])
  classId          String
  payment          Payment?  @relation(fields: [paymentId], references: [id])
  paymentId        String?   @unique
  progress         Progress?
  checkIn          CheckIn?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  checkInId        String?
  progressId       String?

  @@index([classId])
  @@index([userId])
}

model Workout {
  id            String     @id @default(cuid())
  name          String
  description   String
  totalDuration Int
  level         String
  active        Boolean    @default(true)
  exercises     Exercise[]
  classes       Class[]
}

model Exercise {
  id          String  @id @default(cuid())
  name        String
  type        String
  duration    Int
  repetitions Int
  description String
  image       String?
  workout     Workout @relation(fields: [workoutId], references: [id])
  workoutId   String

  @@index([workoutId])
}

model Progress {
  id            String   @id @default(cuid())
  registerDate  DateTime
  weight        Decimal?
  fatPercentage Decimal?
  level         String?
  observations  String?
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingId     String   @unique
}

model CheckIn {
  id           String   @id @default(cuid())
  date         DateTime
  hour         String
  present      Boolean
  observations String?
  booking      Booking  @relation(fields: [bookingId], references: [id])
  bookingId    String   @unique
}

model Payment {
  id          String   @id @default(cuid())
  paymentDate DateTime
  value       Decimal
  method      String
  status      String
  description String
  booking     Booking?
  bookingId   String?
  plan        Plan?    @relation(fields: [planId], references: [id])
  planId      String?

  @@index([planId])
}

model StudioInfo {
  id            String         @id @default(cuid())
  name          String
  address       String
  phone         String
  email         String
  workingHours  String
  description   String
  coverImage    String?
  galleryImages GalleryImage[]
}

model GalleryImage {
  id          String     @id @default(cuid())
  title       String
  description String
  url         String
  uploadDate  DateTime
  studio      StudioInfo @relation(fields: [studioId], references: [id])
  studioId    String

  @@index([studioId])
}

model Notification {
  id      String  @id @default(cuid())
  message String
  read    Boolean @default(false)
  userId  String
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
}
